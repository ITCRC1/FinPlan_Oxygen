# Variables del backend — Amarena.
#
# Copiar a `.env` para desarrollo local; en Railway se cargan como variables del
# servicio. `.env` está en .gitignore y NUNCA se commitea.
#
# ⚠️ Los defaults del código ya son los de Amarena (`app/hotel_actual.py`), así
# que una variable que falte no convierte esta instalación en otra propiedad.
# Aun así conviene ponerlas todas: son la fuente de verdad del despliegue.

# ── Identidad de la propiedad ────────────────────────────────────────────────
HOTEL_ID=AMA
HOTEL_NAME=Amarena Canvas Beach Hotel
HOTEL_SHORT_NAME=Amarena

# ⚠️ El número REAL de habitaciones. En 0 el sistema arranca y lo dice; con un
# número equivocado arranca callado y el error se arrastra a ocupación, RevPAR y
# P&L sin que nada falle. También se edita en Master Data → Provisionamiento.
HOTEL_ROOMS=0

# Tipo de cambio CRC/USD de arranque. Divide todo salario en colones, así que
# nunca va en 0. El definitivo se carga mes a mes en el escenario.
HOTEL_TC_USD=530.0000

# ── Base de datos ────────────────────────────────────────────────────────────
# ⚠️ Base PROPIA de Amarena. No se comparte con ninguna otra propiedad.
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost/finplan_amarena

# ── Seguridad ────────────────────────────────────────────────────────────────
# ⚠️ Generar uno nuevo y NO reusar el de otra propiedad. Firma los tokens de
# sesión: con el mismo secreto en dos instalaciones, un token de una vale en la
# otra. Generar con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production

# ── Opcionales ───────────────────────────────────────────────────────────────
# Carpeta de Excel de referencia para los importadores (solo desarrollo local).
# DATA_DIR=

# Llave de solo lectura del consolidado. Nace apagada: sin esta variable no
# existe ninguna llave válida. Ver `app/auth.py`.
# CONSOLIDADO_API_KEY=
